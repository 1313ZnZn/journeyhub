# Backend only. Use the same random token in Supabase's JOURNEYHUB_AGENT_SERVICE_TOKEN.
JH_SERVICE_TOKEN=
JH_MODEL_API_KEY=
JH_MODEL=deepseek-flash
JH_MODEL_BASE_URL=https://api.deepseek.com
JH_DEEPSEEK_DISABLE_THINKING=true
# For OpenAI: choose your model, base URL https://api.openai.com/v1, and set the above false.
JH_REQUEST_TIMEOUT_SECONDS=35
JH_MAX_CONCURRENCY=8
# LangSmith tracing is not enabled by this service. Never enable it with real user
# conversations without separately reviewing what is sent to the tracing provider.
