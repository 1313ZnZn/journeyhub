# Server-only: enter real values in Supabase Edge Function Secrets.
# Never put keys in config.js or index.html, and never share a filled .env file.
JOURNEYHUB_AI_PROVIDER=deepseek
JOURNEYHUB_AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# Email deliberately unconfigured. Reservations work independently.
JOURNEYHUB_MAIL_PROVIDER=
JOURNEYHUB_MAIL_FROM=
JOURNEYHUB_APP_URL=
# Optional future SMTP over TLS on port 465:
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Live place discovery (server only). Enable Places API (New) in Google Cloud.
GOOGLE_PLACES_API_KEY=
# Optional separate signing key; otherwise the server-only service key is used.
JOURNEYHUB_DISCOVERY_SIGNING_KEY=

# Separate public browser key: Maps JavaScript API + HTTP-referrer restrictions.
GOOGLE_MAPS_BROWSER_KEY=
# Optional separate server key for Routes API; falls back to GOOGLE_PLACES_API_KEY.
GOOGLE_ROUTES_API_KEY=

# Additional server settings; fill only in your development environment.
AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
AMAP_WEB_SERVICE_KEY=
FLYAI_API_KEY=
FLYAI_SIGN_SECRET=
JOURNEYHUB_AGENT_WORKER_SECRET=
JOURNEYHUB_AI_API_KEY=
JOURNEYHUB_AI_BASE_URL=
JOURNEYHUB_AI_PROTOCOL=
JOURNEYHUB_SMTP_RUNTIME=
RESEND_API_KEY=
SUPABASE_SECRET_KEYS=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# Optional staged Python/LangChain decision runtime for durable planner + Trip Agent.
# Keep legacy until the separate Python service and both Edge entrypoints
# (journeyhub-agent, journeyhub-planner) are deployed and verified.
JOURNEYHUB_AGENT_RUNTIME=legacy
JOURNEYHUB_AGENT_SERVICE_URL=
JOURNEYHUB_AGENT_SERVICE_TOKEN=
# Local development only. Allows loopback HTTP; never needed for hosted HTTPS.
JOURNEYHUB_AGENT_ALLOW_LOCAL=false
